    y: 430.0
  }
  type: TYPE_BOX
  id: "status_frozen/box"
  parent: "status_frozen"
  overridden_fields: 4
  template_node_child: true
}
nodes {
  color {
    x: 0.6
    y: 0.8509804
    z: 0.8509804
  }
  type: TYPE_TEXT
  text: "Frozen"
  id: "status_frozen/title"
  parent: "status_frozen/box"
  overridden_fields: 5
  overridden_fields: 8
  template_node_child: true
}
nodes {
  type: TYPE_TEXT
  text: "A frozen creature is incapacitated and restrained. In combat, it can attempt to break free of the ice with a STR save at the end of each of its turns against a DC of 10 + the proficiency bonus of the creature that caused this status. The frozen status ends immediately if the frozen creature takes damage from a move that has the possibility of causing the burned status. Outside of combat, the frozen status lasts for one hour. (Ice types are immune to this status condition)"
  id: "status_frozen/description"
  parent: "status_frozen/box"
  overridden_fields: 8
  template_node_child: true
}
nodes {
  position {
    y: -1123.0
  }
  type: TYPE_TEMPLATE
  id: "status_paralyzed"
  parent: "scrolling_root"
  inherit_alpha: true
  template: "/templates/status.gui"
}
