nodes {
  type: TYPE_TEXT
  id: "status_burned/title"
  parent: "status_burned/box"
  template_node_child: true
}
nodes {
  type: TYPE_TEXT
  text: "A burned Pok\303\251mon rolls all damage rolls twice and takes the lower result (this bypasses and does not cancel out with things like Savage Attacker, Iron Fist, Weather, etc). In addition, the creature takes an amount of damage equal to its proficiency bonus at the beginning of each of its turns until it faints or is cured of its burns. (Fire types are immune to this status condition)"
  id: "status_burned/description"
  parent: "status_burned/box"
  overridden_fields: 8
  template_node_child: true
}
nodes {
  position {
    y: -378.0
  }
  type: TYPE_TEMPLATE
  id: "status_poisoned"
  parent: "scrolling_root"
  inherit_alpha: true
  template: "/templates/status.gui"
}
nodes {
  size {
    x: 700.0
    y: 306.0
  }
  type: TYPE_BOX
  id: "status_poisoned/box"
  parent: "status_poisoned"
  overridden_fields: 4
  template_node_child: true
}
nodes {
  color {
    x: 0.6313726
    y: 0.21176471
    z: 0.6313726
  }
  type: TYPE_TEXT
  text: "Poisoned"
  id: "status_poisoned/title"
  parent: "status_poisoned/box"
  overridden_fields: 5
  overridden_fields: 8
  template_node_child: true
}
nodes {
  type: TYPE_TEXT
  text: "A poisoned creature has disadvantage on all ability checks and attack rolls, and takes an amount of damage equal to its proficiency bonus at the end of each of its turns until it faints or is cured of its poison. (Poison and Steel types are immune to this status condition)"
  id: "status_poisoned/description"
  parent: "status_poisoned/box"
  overridden_fields: 8
  template_node_child: true
}
nodes {
  position {
    y: -689.0
  }
  type: TYPE_TEMPLATE
