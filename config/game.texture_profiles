path_settings {
  path: "/**/*.atlas"
  profile: "atlas_profile"
}
profiles {
  name: "atlas_profile"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGBA
      compressor: "BasisU"
      compressor_preset: "BASISU_MEDIUM"
    }
    mipmaps: false
    max_texture_size: 4096
  }
}
